{
  "name": "@zimbo-mate/task-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "Advanced task management system for ZimboMate",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "tm:move": "node ./tools/tm/cli.js move",
    "tm": "node ./tools/tm/cli.js",
    "tm:list": "node ./tools/tm/cli.js list",
    "tm:next": "node ./tools/tm/cli.js next",
    "plan:from-prd": "tsx ./scripts/planFromPrd.ts",
    "audit-tasks": "tsx ./scripts/auditTaskStatus.ts",
    "setup-workflow": "tsx ./scripts/setupWorkflowAutomation.ts",
    "task": "tsx ./scripts/taskHelpers.ts",
    "task:manager": "tsx ./scripts/taskManager.ts",
    "task:stats": "tsx ./scripts/taskManager.ts stats",
    "task:update": "tsx ./scripts/taskManager.ts update",
    "task:completion": "tsx ./scripts/taskCompletionWorkflow.ts",
    "task:combine": "tsx ./scripts/taskManager.ts combine",
    "task:migrate": "tsx ./scripts/migrateTasks.ts migrate",
    "task:migrate:combine": "tsx ./scripts/migrateTasks.ts combine",
    "cleanup-tasks": "tsx ./scripts/cleanupTasks.ts",
    "auto-cleanup": "tsx ./scripts/autoCleanupTasks.ts",
    "tm:enhanced": "tsx ./scripts/enhancedTaskManager.ts",
    "dashboard": "tsx ./scripts/singleDashboard.ts",
    "dashboard:api": "tsx ./scripts/dashboardAPI.ts",
    "dashboard:launch": "tsx ./scripts/launchDashboardIntegrated.ts",
    "dashboard:test": "tsx ./scripts/testDashboardIntegration.ts",
    "dashboard:full": "tsx ./scripts/singleDashboard.ts && start http://localhost:3001/dashboard.html",
    "dashboard:watch": "tsx ./scripts/singleDashboard.ts",
    "dashboard:html": "tsx ./scripts/singleDashboard.ts",
    "setup-git-hooks": "tsx ./scripts/enhancedGitHooks.ts",
    "browse": "tsx ./scripts/taskBrowser.ts",
    "dashboard:auto": "tsx ./scripts/autoUpdateDashboard.ts",
    "semgrep": "tsx ./scripts/semgrepIntegration.ts",
    "semgrep:scan": "semgrep scan --config .semgrep.yml",
    "semgrep:autofix": "semgrep scan --config .semgrep.yml --autofix",
    "semgrep:report": "tsx ./scripts/semgrepIntegration.ts --report",
    "semgrep:setup": "tsx ./scripts/setupSemgrep.ts",
    "semgrep:dashboard": "tsx ./scripts/semgrepDashboardServer.ts",
    "semgrep:demo": "tsx ./scripts/demoEnhancedFeatures.ts",
    "semgrep:fix": "tsx ./scripts/fixSemgrepIssues.ts",
    "lint:fix-advanced": "tsx ./scripts/fixESLintIssues.ts",
    "semgrep:fix-aggressive": "tsx ./scripts/aggressiveSemgrepFix.ts",
    "semgrep:fix-targeted": "tsx ./scripts/targetedSemgrepFix.ts",
    "semgrep:fix-super": "tsx ./scripts/superAggressiveSemgrepFix.ts",
    "fix:spacing": "tsx ./scripts/fixSpacingCorruption.ts",
    "fix:syntax": "tsx ./scripts/fixSyntaxErrors.ts",
    "test:automated": "tsx ./scripts/automatedTesting.ts",
    "test:mcp": "tsx ./scripts/mcpPuppeteerIntegration.ts",
    "test:comprehensive": "tsx ./scripts/comprehensiveTesting.ts",
    "workflow:intelligence": "tsx ./scripts/workflowIntelligence.ts",
    "workflow:automation": "tsx ./scripts/workflowAutomation.ts",
    "analytics:advanced": "tsx ./scripts/advancedAnalytics.ts",
    "lint:enhanced": "eslint . --config eslint.config.enhanced.js",
    "lint:fix:enhanced": "eslint . --config eslint.config.enhanced.js --fix",
    "lint:summary": "tsx ./scripts/quickSummary.ts",
    "dashboard:data": "tsx ./scripts/dashboardAPI.ts",
    "task:api": "tsx ./scripts/taskAPI.ts",
    "lint:fix:aggressive": "eslint . --config eslint.config.enhanced.js --fix --fix-type problem,suggestion,layout",
    "test:modal": "tsx ./scripts/puppeteerTaskModalTest.ts",
    "test:visual": "tsx ./scripts/visualTaskModalTest.ts",
    "analyze:visual": "tsx ./scripts/puppeteerVisualAnalyzer.ts",
    "analyze:playwright:modal": "tsx ./scripts/playwrightModalAnalysis.ts",
    "gallery": "tsx ./scripts/generateImageGallery.ts",
    "test:t196": "tsx ./scripts/testRealTaskModal.ts",
    "debug:data": "tsx ./scripts/debugDataLoading.ts",
    "test:data-flow": "tsx ./scripts/testRealDataFlow.ts",
    "test:modal-real": "tsx ./scripts/testTaskModalRealData.ts",
    "test:t196": "tsx ./scripts/testT196Automated.ts",
    "test:t196-simple": "tsx ./scripts/testT196Simple.ts",
    "integrate:t196": "tsx ./scripts/autoIntegrateT196.ts",
    "test:dungeon-world-t196": "tsx ./scripts/testDungeonWorldT196.ts",
    "fix:t196": "tsx ./scripts/fixT196Integration.ts"
  },
  "dependencies": {
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "glob": "^11.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0",
    "ws": "^8.14.2",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.0.0",
    "puppeteer": "^24.18.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^0.34.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

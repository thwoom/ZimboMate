ty-lines","url":"https://eslint.style/rules/no-multiple-empty-lines"}}]}},{"ruleId":"no-trailing-spaces","replacedBy":["@stylistic/no-trailing-spaces"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"no-trailing-spaces","url":"https://eslint.style/rules/no-trailing-spaces"}}]}},{"ruleId":"object-curly-spacing","replacedBy":["@stylistic/object-curly-spacing"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"object-curly-spacing","url":"https://eslint.style/rules/object-curly-spacing"}}]}},{"ruleId":"quotes","replacedBy":["@stylistic/quotes"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"quotes","url":"https://eslint.style/rules/quotes"}}]}},{"ruleId":"semi","replacedBy":["@stylistic/semi"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"semi","url":"https://eslint.style/rules/semi"}}]}},{"ruleId":"space-before-blocks","replacedBy":["@stylistic/space-before-blocks"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-before-blocks","url":"https://eslint.style/rules/space-before-blocks"}}]}},{"ruleId":"space-before-function-paren","replacedBy":["@stylistic/space-before-function-paren"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-before-function-paren","url":"https://eslint.style/rules/space-before-function-paren"}}]}},{"ruleId":"space-in-parens","replacedBy":["@stylistic/space-in-parens"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-in-parens","url":"https://eslint.style/rules/space-in-parens"}}]}},{"ruleId":"space-infix-ops","replacedBy":["@stylistic/space-infix-ops"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-infix-ops","url":"https://eslint.style/rules/space-infix-ops"}}]}},{"ruleId":"space-unary-ops","replacedBy":["@stylistic/space-unary-ops"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-unary-ops","url":"https://eslint.style/rules/space-unary-ops"}}]}},{"ruleId":"spaced-comment","replacedBy":["@stylistic/spaced-comment"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"spaced-comment","url":"https://eslint.style/rules/spaced-comment"}}]}}]},{"filePath":"C:\\ZimboMate\\src\\components\\EnhancedDiceRoller.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (326). Maximum allowed is 100.","line":24,"column":65,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":349,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 42. Maximum allowed is 15.","line":24,"column":65,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":349,"endColumn":2},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'error' is defined but never used. Allowed unused caught errors must match /^_/u.","line":80,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":80,"endColumn":19},{"ruleId":"no-alert","severity":1,"message":"Unexpected alert.","line":81,"column":7,"nodeType":"CallExpression","messageId":"unexpected","endLine":81,"endColumn":54},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getRollResultColor' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":104,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":104,"endColumn":27},{"ruleId":"react/no-array-index-key","severity":1,"message":"Do not use Array index in keys","line":136,"column":20,"nodeType":"Identifier","messageId":"noArrayIndex","endLine":136,"endColumn":25},{"ruleId":"react/no-array-index-key","severity":1,"message":"Do not use Array index in keys","line":176,"column":20,"nodeType":"Identifier","messageId":"noArrayIndex","endLine":176,"endColumn":25}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Enhanced Dice Roller Component * Supports all dice types, modifiers, and advanced rolling features\r\n */\r\n\r\nimport React, { useState } from 'react';\r\nimport {\r\n  diceRollingService,\r\n  EnhancedDiceRoll,\r\n  RollType,\r\n} from '../services/DiceRollingService';\r\nimport DiceAnimation from './DiceAnimation';\r\nimport './EnhancedDiceRoller.css';\r\n\r\ninterface EnhancedDiceRollerProps {\r\n  onRoll?: (roll: EnhancedDiceRoll) => void;\r\n  defaultExpression?: string;\r\n  showHistory?: boolean;\r\n  compact?: boolean;\r\n  showAnimation?: boolean;\r\n  animationTheme?: 'classic' | 'neon' | 'wood' | 'metal' | 'bone';\r\n  soundEnabled?: boolean;\r\n}\r\n\r\nconst EnhancedDiceRoller: React.FC < EnhancedDiceRollerProps> = ({\r\n  onRoll,\r\n  defaultExpression = '2d6',\r\n  showHistory = true,\r\n  compact = false,\r\n  showAnimation = true,\r\n  animationTheme = 'classic',\r\n  soundEnabled = true,\r\n}) => {\r\n  const [expression, setExpression] = useState(defaultExpression);\r\n  const [modifier, setModifier] = useState(0);\r\n  const [targetNumber, setTargetNumber] = useState < number | undefined>();\r\n  const [rollType, setRollType] = useState < RollType>('custom');\r\n  const [advantage, setAdvantage] = useState(false);\r\n  const [disadvantage, setDisadvantage] = useState(false);\r\n  const [lastRoll, setLastRoll] = useState < EnhancedDiceRoll | null>(null);\r\n  const [rollHistory, setRollHistory] = useState < EnhancedDiceRoll[]>([]);\r\n  const [showAdvanced, setShowAdvanced] = useState(false);\r\n\r\n  // Quick dice buttons\r\n  const quickDice: { label: string; expression: string; type: RollType }[] = [\r\n    { label: '2d6', expression: '2d6', type: 'move' },\r\n    { label: '1d4', expression: '1d4', type: 'damage' },\r\n    { label: '1d6', expression: '1d6', type: 'damage' },\r\n    { label: '1d8', expression: '1d8', type: 'damage' },\r\n    { label: '1d10', expression: '1d10', type: 'damage' },\r\n    { label: '1d12', expression: '1d12', type: 'damage' },\r\n    { label: '1d20', expression: '1d20', type: 'target' },\r\n  ];\r\n\r\n  const handleRoll = () => {\r\n    try {\r\n      let roll: EnhancedDiceRoll;\r\n\r\n      if (rollType === 'target' && targetNumber !== undefined) {\r\n        // Parse expression for target rolls\r\n        const diceExpr = diceRollingService.parseDiceExpression(expression);\r\n        roll = diceRollingService.rollTarget(targetNumber, diceExpr.type, diceExpr.count, modifier, {\r\n          advantage,\r\n          disadvantage,\r\n          type: rollType,\r\n        });\r\n      } else {\r\n        // Regular roll\r\n        roll = diceRollingService.rollFromString(expression, {\r\n          modifier,\r\n          advantage,\r\n          disadvantage,\r\n          type: rollType,\r\n          targetNumber,\r\n        });\r\n      }\r\n\r\n      setLastRoll(roll);\r\n      setRollHistory(prev => [roll, ...prev.slice(0, 9)]); // Keep last 10 rolls\r\n      onRoll?.(roll);\r\n    } catch (error) {\r\n      alert(`Invalid dice expression: ${expression}`);\r\n    }\r\n  };\r\n\r\n  const handleReroll = () => {\r\n    if (lastRoll) {\r\n      const reroll = diceRollingService.rerollDice(lastRoll, { spendXP: true });\r\n      setLastRoll(reroll);\r\n      setRollHistory(prev => [reroll, ...prev.slice(0, 9)]);\r\n      onRoll?.(reroll);\r\n    }\r\n  };\r\n\r\n  const handleQuickDice = (quickDice: { expression: string; type: RollType }) => {\r\n    setExpression(quickDice.expression);\r\n    setRollType(quickDice.type);\r\n    if (quickDice.type === 'target') {\r\n      setTargetNumber(targetNumber || 15);\r\n    } else {\r\n      setTargetNumber(undefined);\r\n    }\r\n  };\r\n\r\n  const getRollResultColor = (roll: EnhancedDiceRoll): string => {\r\n    if (roll.rollResult) {\r\n      switch (roll.rollResult) {\r\n        case 'success': return 'var(--color-roll-success)';\r\n        case 'partial': return 'var(--color-roll-partial)';\r\n        case 'failure': return 'var(--color-roll-failure)';\r\n      }\r\n    }\r\n    if (roll.success !== undefined) {\r\n      return roll.success ? 'var(--color-roll-success)' : 'var(--color-roll-failure)';\r\n    }\r\n    return 'var(--color-text-primary)';\r\n  };\r\n\r\n  if (compact) {\r\n    return (\r\n      <div className=\"enhanced-dice-roller compact\">\r\n        {/* Dice Animation for Compact Mode */}\r\n        {showAnimation && lastRoll && (\r\n          <div className=\"dice-animation-section compact\">\r\n            <DiceAnimation\r\n              roll={lastRoll}\r\n              theme={animationTheme}\r\n              size=\"small\"\r\n              soundEnabled={soundEnabled}\r\n            />\r\n          </div>\r\n        )}\r\n\r\n        <div className=\"quick-dice-grid\">\r\n          {quickDice.map((dice, index) => (\r\n            <button\r\n              key={index}\r\n              className=\"quick-dice-btn\"\r\n              onClick={() => {\r\n                handleQuickDice(dice);\r\n                setTimeout(handleRoll, 100);\r\n              }}\r\n            >\r\n              {dice.label}\r\n            </button>\r\n          ))}\r\n        </div>\r\n        {lastRoll && (\r\n          <div className=\"last-roll-compact\">\r\n            <span className={`roll-result-text ${lastRoll.rollResult || (lastRoll.success !== undefined ? (lastRoll.success ? 'success' : 'failure') : 'neutral')}`}>\r\n              {diceRollingService.formatEnhancedRoll(lastRoll)}\r\n            </span>\r\n          </div>\r\n        )}\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"enhanced-dice-roller\">\r\n      <div className=\"dice-roller-header\">\r\n        <h3>≡ƒÄ▓ Enhanced Dice Roller</h3>\r\n        <button\r\n          className=\"toggle-advanced\"\r\n          onClick={() => setShowAdvanced(!showAdvanced)}\r\n        >\r\n          {showAdvanced ? 'Simple' : 'Advanced'}\r\n        </button>\r\n      </div>\r\n\r\n      {/* Quick Dice Buttons */}\r\n      <div className=\"quick-dice-section\">\r\n        <h4 > Quick Dice</h4>\r\n        <div className=\"quick-dice-grid\">\r\n          {quickDice.map((dice, index) => (\r\n            <button\r\n              key={index}\r\n              className={`quick-dice-btn ${expression === dice.expression ? 'active' : ''}`}\r\n              onClick={() => handleQuickDice(dice)}\r\n            >\r\n              {dice.label}\r\n            </button>\r\n          ))}\r\n        </div>\r\n      </div>\r\n\r\n      {/* Main Roll Controls */}\r\n      <div className=\"roll-controls\">\r\n        <div className=\"expression-input\">\r\n          <label > Dice Expression:</label>\r\n          <input\r\n            type=\"text\"\r\n            value={expression}\r\n            onChange={(e) => setExpression(e.target.value)}\r\n            placeholder=\"e.g., 2d6, 1d8 + 2, 3d4\"\r\n          />\r\n        </div>\r\n\r\n        <div className=\"modifier-input\">\r\n          <label > Modifier:</label>\r\n          <input\r\n            type=\"number\"\r\n            value={modifier}\r\n            onChange={(e) => setModifier(parseInt(e.target.value) || 0)}\r\n            aria-label=\"Dice roll modifier\"\r\n          />\r\n        </div>\r\n\r\n        {rollType === 'target' && (\r\n          <div className=\"target-input\">\r\n            <label > Target Number:</label>\r\n            <input\r\n              type=\"number\"\r\n              value={targetNumber || ''}\r\n              onChange={(e) => setTargetNumber(parseInt(e.target.value) || undefined)}\r\n              placeholder=\"15\"\r\n            />\r\n          </div>\r\n        )}\r\n      </div>\r\n\r\n      {/* Advanced Options */}\r\n      {showAdvanced && (\r\n        <div className=\"advanced-options\">\r\n          <div className=\"roll-type-select\">\r\n            <label > Roll Type:</label>\r\n            <select\r\n              value={rollType}\r\n              onChange={(e) => setRollType(e.target.value as RollType)}\r\n              aria-label=\"Select roll type\"\r\n            >\r\n              <option value=\"custom\">Custom</option>\r\n              <option value=\"move\">Move (2d6)</option>\r\n              <option value=\"damage\">Damage</option>\r\n              <option value=\"stat\">Stat Roll</option>\r\n              <option value=\"target\">Target Number</option>\r\n            </select>\r\n          </div>\r\n\r\n          <div className=\"advantage-controls\">\r\n            <label>\r\n              <input\r\n                type=\"checkbox\"\r\n                checked={advantage}\r\n                onChange={(e) => {\r\n                  setAdvantage(e.target.checked);\r\n                  if (e.target.checked) setDisadvantage(false);\r\n                }}\r\n              />\r\n              Advantage\r\n            </label>\r\n            <label>\r\n              <input\r\n                type=\"checkbox\"\r\n                checked={disadvantage}\r\n                onChange={(e) => {\r\n                  setDisadvantage(e.target.checked);\r\n                  if (e.target.checked) setAdvantage(false);\r\n                }}\r\n              />\r\n              Disadvantage\r\n            </label>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* Roll Button */}\r\n      <div className=\"roll-actions\">\r\n        <button className=\"roll-btn primary\" onClick={handleRoll}>\r\n          ≡ƒÄ▓ Roll {expression}{modifier !== 0 && (modifier > 0 ? '+' : '')}{modifier !== 0 && modifier}\r\n        </button>\r\n        {lastRoll && (\r\n          <button className=\"reroll-btn secondary\" onClick={handleReroll}>\r\n            ≡ƒöä Reroll (Spend XP)\r\n          </button>\r\n        )}\r\n      </div>\r\n\r\n      {/* Dice Animation */}\r\n      {showAnimation && lastRoll && (\r\n        <div className=\"dice-animation-section\">\r\n          <DiceAnimation\r\n            roll={lastRoll}\r\n            theme={animationTheme}\r\n            size={compact ? 'small' : 'medium'}\r\n            soundEnabled={soundEnabled}\r\n          />\r\n        </div>\r\n      )}\r\n\r\n      {/* Last Roll Display */}\r\n      {lastRoll && (\r\n        <div className=\"last-roll-display\">\r\n          <h4 > Last Roll:</h4>\r\n          <div className={`roll-result roll-result-text ${lastRoll.rollResult || (lastRoll.success !== undefined ? (lastRoll.success ? 'success' : 'failure') : 'neutral')}`}>\r\n            <div className=\"roll-expression\">\r\n              {lastRoll.expression.count}{lastRoll.expression.type}\r\n              {lastRoll.modifier !== 0 && ` ${lastRoll.modifier >= 0 ? '+' : ''}${lastRoll.modifier}`}\r\n            </div>\r\n            <div className=\"roll-breakdown\">\r\n              Rolled: [{lastRoll.results.join(', ')}] = {lastRoll.total}\r\n              {lastRoll.modifier !== 0 && ` ${lastRoll.modifier >= 0 ? '+' : ''}${lastRoll.modifier}`}\r\n              = <strong>{lastRoll.finalResult}</strong>\r\n            </div>\r\n            {lastRoll.rollResult && (\r\n              <div className=\"roll-outcome\">\r\n                {lastRoll.rollResult === 'success' && 'Γ£à Success (10+)'}\r\n                {lastRoll.rollResult === 'partial' && 'ΓÜá∩╕Å Partial Success (7-9)'}\r\n                {lastRoll.rollResult === 'failure' && 'Γ¥î Failure (6-)'}\r\n              </div>\r\n            )}\r\n            {lastRoll.success !== undefined && (\r\n              <div className=\"roll-outcome\">\r\n                {lastRoll.success ? 'Γ£à Success' : 'Γ¥î Failure'}\r\n                {lastRoll.targetNumber && ` (Target: ${lastRoll.targetNumber})`}\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* Roll History */}\r\n      {showHistory && rollHistory.length > 0 && (\r\n        <div className=\"roll-history\">\r\n          <h4 > Recent Rolls:</h4>\r\n          <div className=\"history-list\">\r\n            {rollHistory.slice(0, 5).map((roll) => (\r\n              <div key={roll.id} className=\"history-item\">\r\n                <span className=\"history-expression\">\r\n                  {roll.expression.count}{roll.expression.type}\r\n                  {roll.modifier !== 0 && (roll.modifier > 0 ? '+' : '')}{roll.modifier !== 0 && roll.modifier}\r\n                </span>\r\n                <span className={`history-result roll-result-text ${roll.rollResult || (roll.success !== undefined ? (roll.success ? 'success' : 'failure') : 'neutral')}`}>\r\n                  {roll.finalResult}\r\n                </span>\r\n                {roll.rollResult && (\r\n                  <span className=\"history-outcome\">\r\n                    {roll.rollResult === 'success' && 'Γ£à'}\r\n                    {roll.rollResult === 'partial' && 'ΓÜá∩╕Å'}\r\n                    {roll.rollResult === 'failure' && 'Γ¥î'}\r\n                  </span>\r\n                )}\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default EnhancedDiceRoller;\r\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-var-requires","replacedBy":["@typescript-eslint/no-require-imports"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-require-imports","url":"https://typescript-eslint.io/rules/no-require-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8334"}},{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}},{"ruleId":"array-bracket-spacing","replacedBy":["@stylistic/array-bracket-spacing"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"array-bracket-spacing","url":"https://eslint.style/rules/array-bracket-spacing"}}]}},{"ruleId":"block-spacing","replacedBy":["@stylistic/block-spacing"],"info":{"message":"Formattin
e-before-function-paren"}}]}},{"ruleId":"space-in-parens","replacedBy":["@stylistic/space-in-parens"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-in-parens","url":"https://eslint.style/rules/space-in-parens"}}]}},{"ruleId":"space-infix-ops","replacedBy":["@stylistic/space-infix-ops"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-infix-ops","url":"https://eslint.style/rules/space-infix-ops"}}]}},{"ruleId":"space-unary-ops","replacedBy":["@stylistic/space-unary-ops"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-unary-ops","url":"https://eslint.style/rules/space-unary-ops"}}]}},{"ruleId":"spaced-comment","replacedBy":["@stylistic/spaced-comment"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"spaced-comment","url":"https://eslint.style/rules/spaced-comment"}}]}}]},{"filePath":"C:\\ZimboMate\\src\\panels\\SpecialMovesPanel\\SpecialMovesPanel.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useEffect' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":27,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":36},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (246). Maximum allowed is 100.","line":17,"column":51,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":262,"endColumn":2},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'api' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":18,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":18,"endColumn":12},{"ruleId":"no-alert","severity":1,"message":"Unexpected alert.","line":86,"column":7,"nodeType":"CallExpression","messageId":"unexpected","endLine":86,"endColumn":28},{"ruleId":"no-alert","severity":1,"message":"Unexpected alert.","line":88,"column":7,"nodeType":"CallExpression","messageId":"unexpected","endLine":88,"endColumn":28},{"ruleId":"no-alert","severity":1,"message":"Unexpected alert.","line":96,"column":5,"nodeType":"CallExpression","messageId":"unexpected","endLine":96,"endColumn":108},{"ruleId":"space-infix-ops","severity":2,"message":"Operator '-' must be spaced.","line":136,"column":29,"nodeType":"BinaryExpression","messageId":"missingSpace","endLine":136,"endColumn":30,"fix":{"range":[4859,4860],"text":" - "}}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { createPanel, PanelProps } from '../../framework/Panel';\r\nimport { createPanelAPI } from '../../framework/PanelAPI';\r\nimport { useGameStore } from '../../store/GameStore';\r\nimport { SpecialMovesService } from '../../services/SpecialMovesService';\r\nimport LevelUpModal from '../../components/LevelUpModal';\r\nimport EndOfSessionModal from '../../components/EndOfSessionModal';\r\nimport './SpecialMovesPanel.css';\r\n\r\ninterface SpecialMovesPanelState {\r\n  showLevelUpModal: boolean;\r\n  showEndOfSessionModal: boolean;\r\n  showMakeCampModal: boolean;\r\n  showLastBreathModal: boolean;\r\n}\r\n\r\nconst SpecialMovesPanel: React.FC < PanelProps> = ({ id }) => {\r\n  const api = createPanelAPI(id);\r\n  const { state: gameState, updateCharacter } = useGameStore();\r\n  const [panelState, setPanelState] = useState < SpecialMovesPanelState>({\r\n    showLevelUpModal: false,\r\n    showEndOfSessionModal: false,\r\n    showMakeCampModal: false,\r\n    showLastBreathModal: false,\r\n  });\r\n\r\n  // Get active character\r\n  const character = gameState.activeCharacterId ?\r\n    gameState.characters[gameState.activeCharacterId] : null;\r\n\r\n  // Special moves state\r\n  const canLevelUp = character ? SpecialMovesService.canLevelUp(character) : false;\r\n  const shouldTriggerLastBreath = character ? SpecialMovesService.shouldTriggerLastBreath(character) : false;\r\n  const xpProgress = character ? SpecialMovesService.getXPProgress(character) : 0;\r\n  const nextLevelXP = character ? SpecialMovesService.getNextLevelXP(character) : 0;\r\n\r\n  const updateState = (updates: Partial < SpecialMovesPanelState>) => {\r\n    setPanelState(prev => ({ ...prev, ...updates }));\r\n  };\r\n\r\n  const handleLevelUp = (result: unknown, advancementChoice?: string) => {\r\n    if (character && result.success) {\r\n      // Update character with new level and XP\r\n      const updates: unknown = {\r\n        level: result.newLevel,\r\n        xp: result.newXP,\r\n      };\r\n\r\n      // Add advancement choice to character's advancement history\r\n      if (advancementChoice) {\r\n        const newAdvancement = {\r\n          level: result.newLevel,\r\n          type: advancementChoice.includes('Increase') ? 'stat' : 'move',\r\n          choice: advancementChoice,\r\n          description: advancementChoice,\r\n          timestamp: new Date(),\r\n        };\r\n        updates.advancements = [...(character.advancements || []), newAdvancement];\r\n      }\r\n\r\n      (updateCharacter as string)(character.id, updates);\r\n    }\r\n    updateState({ showLevelUpModal: false });\r\n  };\r\n\r\n  const handleEndOfSession = (result: unknown) => {\r\n    if (character) {\r\n      (updateCharacter as string)(character.id, { xp: result.totalXP });\r\n    }\r\n    updateState({ showEndOfSessionModal: false });\r\n  };\r\n\r\n  const handleMakeCamp = () => {\r\n    if (!character) return;\r\n\r\n    const result = SpecialMovesService.makeCamp(character, true);\r\n\r\n    if (result.success) {\r\n      // Update HP\r\n      const newHP = Math.min(character.hp.current + result.hpRestored, character.hp.max);\r\n      (updateCharacter as string)(character.id, {\r\n        hp: { ...character.hp, current: newHP },\r\n      });\r\n\r\n      // Note: Ration consumption would need inventory integration\r\n      alert(result.message);\r\n    } else {\r\n      alert(result.message);\r\n    }\r\n  };\r\n\r\n  const handleLastBreath = () => {\r\n    if (!character) return;\r\n\r\n    const result = SpecialMovesService.lastBreath(character);\r\n    alert(`${result.message}\\n\\nRoll: ${result.roll} (${result.tier})\\nConsequence: ${result.consequence}`);\r\n  };\r\n\r\n  if (!character) {\r\n    return (\r\n      <div className=\"special-moves-panel\">\r\n        <div className=\"special-moves-panel__header\">\r\n          <h2>≡ƒÄ▓ Special Moves</h2>\r\n        </div>\r\n        <div className=\"no-character\">\r\n          <p > No character selected. Create or select a character to access special moves.</p>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"special-moves-panel\">\r\n      <div className=\"special-moves-panel__header\">\r\n        <h2>≡ƒÄ▓ Special Moves</h2>\r\n        <div className=\"character-info\">\r\n          <span className=\"character-name\">{character.name}</span>\r\n          <span className=\"character-class\">({character.class})</span>\r\n        </div>\r\n      </div>\r\n\r\n      {/* XP Progress */}\r\n      <div className=\"xp-progress-section\">\r\n        <div className=\"xp-progress-header\">\r\n          <h3 > Experience Progress</h3>\r\n          <span className=\"xp-current\">{character.xp} XP</span>\r\n        </div>\r\n        <div className=\"xp-progress-bar\">\r\n          <div\r\n            className=\"xp-progress-fill\"\r\n            style={{ width: `${xpProgress}%` }}\r\n          />\r\n        </div>\r\n        <div className=\"xp-progress-details\">\r\n          <span > Level {character.level} ΓåÆ {character.level + 1}</span>\r\n          <span>{nextLevelXP-character.xp} XP needed</span>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Special Moves Grid */}\r\n      <div className=\"special-moves-grid\">\r\n        {/* Level Up */}\r\n        <div className={`special-move-card ${canLevelUp ? 'available' : 'unavailable'}`}>\r\n          <div className=\"move-header\">\r\n            <div className=\"move-icon\">≡ƒÄë</div>\r\n            <div className=\"move-title\">Level Up</div>\r\n            <div className=\"move-status\">\r\n              {canLevelUp ? 'Ready!' : 'Not Ready'}\r\n            </div>\r\n          </div>\r\n          <div className=\"move-description\">\r\n            Spend XP to gain a level and choose an advancement.\r\n          </div>\r\n          <button\r\n            className=\"move-button\"\r\n            onClick={() => updateState({ showLevelUpModal: true })}\r\n            disabled={!canLevelUp}\r\n          >\r\n            {canLevelUp ? 'Level Up!' : 'Need More XP'}\r\n          </button>\r\n        </div>\r\n\r\n        {/* End of Session */}\r\n        <div className=\"special-move-card available\">\r\n          <div className=\"move-header\">\r\n            <div className=\"move-icon\">≡ƒÅü</div>\r\n            <div className=\"move-title\">End of Session</div>\r\n            <div className=\"move-status\">Available</div>\r\n          </div>\r\n          <div className=\"move-description\">\r\n            Answer questions to gain XP based on session events.\r\n          </div>\r\n          <button\r\n            className=\"move-button\"\r\n            onClick={() => updateState({ showEndOfSessionModal: true })}\r\n          >\r\n            End Session\r\n          </button>\r\n        </div>\r\n\r\n        {/* Make Camp */}\r\n        <div className=\"special-move-card available\">\r\n          <div className=\"move-header\">\r\n            <div className=\"move-icon\">≡ƒÅò∩╕Å</div>\r\n            <div className=\"move-title\">Make Camp</div>\r\n            <div className=\"move-status\">Available</div>\r\n          </div>\r\n          <div className=\"move-description\">\r\n            Rest and recover HP equal to your level. Consumes 1 ration.\r\n          </div>\r\n          <button\r\n            className=\"move-button\"\r\n            onClick={handleMakeCamp}\r\n          >\r\n            Make Camp\r\n          </button>\r\n        </div>\r\n\r\n        {/* Last Breath */}\r\n        <div className={`special-move-card ${shouldTriggerLastBreath ? 'critical' : 'available'}`}>\r\n          <div className=\"move-header\">\r\n            <div className=\"move-icon\">≡ƒÆÇ</div>\r\n            <div className=\"move-title\">Last Breath</div>\r\n            <div className=\"move-status\">\r\n              {shouldTriggerLastBreath ? 'TRIGGERED!' : 'Available'}\r\n            </div>\r\n          </div>\r\n          <div className=\"move-description\">\r\n            Roll 2d6 when you reach 0 HP to determine your fate.\r\n          </div>\r\n          <button\r\n            className=\"move-button\"\r\n            onClick={handleLastBreath}\r\n            disabled={!shouldTriggerLastBreath}\r\n          >\r\n            {shouldTriggerLastBreath ? 'Roll Last Breath!' : 'Not at 0 HP'}\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Character Status */}\r\n      <div className=\"character-status\">\r\n        <h3 > Character Status</h3>\r\n        <div className=\"status-grid\">\r\n          <div className=\"status-item\">\r\n            <span className=\"status-label\">HP:</span>\r\n            <span className=\"status-value\">\r\n              {character.hp.current} / {character.hp.max}\r\n            </span>\r\n          </div>\r\n          <div className=\"status-item\">\r\n            <span className=\"status-label\">Level:</span>\r\n            <span className=\"status-value\">{character.level}</span>\r\n          </div>\r\n          <div className=\"status-item\">\r\n            <span className=\"status-label\">XP:</span>\r\n            <span className=\"status-value\">{character.xp}</span>\r\n          </div>\r\n          <div className=\"status-item\">\r\n            <span className=\"status-label\">Class:</span>\r\n            <span className=\"status-value\">{character.class}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Modals */}\r\n      <LevelUpModal\r\n        isOpen={panelState.showLevelUpModal}\r\n        character={character}\r\n        onConfirm={handleLevelUp}\r\n        onCancel={() => updateState({ showLevelUpModal: false })}\r\n      />\r\n\r\n      <EndOfSessionModal\r\n        isOpen={panelState.showEndOfSessionModal}\r\n        character={character}\r\n        onConfirm={handleEndOfSession}\r\n        onCancel={() => updateState({ showEndOfSessionModal: false })}\r\n      />\r\n    </div>\r\n  );\r\n};\r\n\r\nexp
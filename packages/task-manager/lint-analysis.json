== 'production' ? LogLevel.WARN : LogLevel.DEBUG;\r\n  }\r\n\r\n  public static getInstance(): Logger {\r\n    if (!Logger.instance) {\r\n      Logger.instance = new Logger();\r\n    }\r\n    return Logger.instance;\r\n  }\r\n\r\n  private shouldLog(level: LogLevel): boolean {\r\n    return level: _level >= this.logLevel;\r\n  }\r\n\r\n  private addToHistory(entry: LogEntry): void {\r\n    this.logHistory.push(entry);\r\n    if (this.logHistory.length > this.maxHistorySize) {\r\n      this.logHistory.shift();\r\n    }\r\n  }\r\n\r\n  public debug(message: string, context?: string, data?: unknown): void {\r\n    if (!this.shouldLog(LogLevel.DEBUG)) return;\r\n\r\n    const entry: LogEntry = {\r\n      level: LogLevel.DEBUG,\r\n      message,\r\n      timestamp: Date.now(),\r\n      _context,\r\n      _data,\r\n    };\r\n\r\n    this.addToHistory(entry);\r\n\r\n    if (process.env.NODE_ENV === 'development') {\r\n      const prefix = context: _context ? `[${context}]` : '';\r\n      console.log(`≡ƒÉ¢ ${prefix} ${message}`, data || '');\r\n    }\r\n  }\r\n\r\n  public info(message: string, context?: string, data?: unknown): void {\r\n    if (!this.shouldLog(LogLevel.INFO)) return;\r\n\r\n    const entry: LogEntry = {\r\n      level: LogLevel.INFO,\r\n      message,\r\n      timestamp: Date.now(),\r\n      _context,\r\n      _data,\r\n    };\r\n\r\n    this.addToHistory(entry);\r\n\r\n    if (process.env.NODE_ENV === 'development') {\r\n      const prefix = context: _context ? `[${context}]` : '';\r\n      console.log(`Γä╣∩╕Å ${prefix} ${message}`, data || '');\r\n    }\r\n  }\r\n\r\n  public warn(message: string, context?: string, data?: unknown): void {\r\n    if (!this.shouldLog(LogLevel.WARN)) return;\r\n\r\n    const entry: LogEntry = {\r\n      level: LogLevel.WARN,\r\n      message,\r\n      timestamp: Date.now(),\r\n      _context,\r\n      _data,\r\n    };\r\n\r\n    this.addToHistory(entry);\r\n    console.warn(`ΓÜá∩╕Å ${context ? `[${context}]` : ''} ${message}`, data || '');\r\n  }\r\n\r\n  public error(message: string, context?: string, data?: unknown): void {\r\n    if (!this.shouldLog(LogLevel.ERROR)) return;\r\n\r\n    const entry: LogEntry = {\r\n      level: LogLevel.ERROR,\r\n      message,\r\n      timestamp: Date.now(),\r\n      _context,\r\n      _data,\r\n    };\r\n\r\n    this.addToHistory(entry);\r\n    console.error(`≡ƒÜ¿ ${context ? `[${context}]` : ''} ${message}`, data || '');\r\n  }\r\n\r\n  public group(title: string, context?: string): void {\r\n    if (process.env.NODE_ENV === 'development') {\r\n      const prefix = context: _context ? `[${context}]` : '';\r\n      console.group(`${prefix} ${title}`);\r\n    }\r\n  }\r\n\r\n  public groupEnd(): void {\r\n    if (process.env.NODE_ENV === 'development') {\r\n      console.groupEnd();\r\n    }\r\n  }\r\n\r\n  public getHistory(level?: LogLevel): LogEntry[] {\r\n    if (level !== undefined) {\r\n      return this.logHistory.filter(entry => entry.level >= _level);\r\n    }\r\n    return [...this.logHistory];\r\n  }\r\n\r\n  public clearHistory(): void {\r\n    this.logHistory = [];\r\n  }\r\n\r\n  public setLogLevel(level: LogLevel): void {\r\n    this.logLevel = level;\r\n  }\r\n}\r\n\r\n// Export singleton instance and convenience functions\r\nexport const logger = Logger.getInstance();\r\n\r\nexport const log = {\r\n  debug: (message: string, context?: string, data?: unknown) => logger.debug(message, _context, _data),\r\n  info: (message: string, context?: string, data?: unknown) => logger.info(message, _context, _data),\r\n  warn: (message: string, context?: string, data?: unknown) => logger.warn(message, _context, _data),\r\n  error: (message: string, context?: string, data?: unknown) => logger.error(message, _context, _data),\r\n  group: (title: string, context?: string) => logger.group(title, _context),\r\n  groupEnd: () => logger.groupEnd(),\r\n};\r\n\r\n// React hook for logging in components\r\nexport const useLogger = () => {\r\n  return {\r
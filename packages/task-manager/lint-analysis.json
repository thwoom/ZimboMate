}]}},{"ruleId":"space-before-function-paren","replacedBy":["@stylistic/space-before-function-paren"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-before-function-paren","url":"https://eslint.style/rules/space-before-function-paren"}}]}},{"ruleId":"space-in-parens","replacedBy":["@stylistic/space-in-parens"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-in-parens","url":"https://eslint.style/rules/space-in-parens"}}]}},{"ruleId":"space-infix-ops","replacedBy":["@stylistic/space-infix-ops"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-infix-ops","url":"https://eslint.style/rules/space-infix-ops"}}]}},{"ruleId":"space-unary-ops","replacedBy":["@stylistic/space-unary-ops"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"space-unary-ops","url":"https://eslint.style/rules/space-unary-ops"}}]}},{"ruleId":"spaced-comment","replacedBy":["@stylistic/spaced-comment"],"info":{"message":"Formatting rules are being moved out of ESLint core.","url":"https://eslint.org/blog/2023/10/deprecating-formatting-rules/","deprecatedSince":"8.53.0","availableUntil":"10.0.0","replacedBy":[{"message":"ESLint Stylistic now maintains deprecated stylistic core rules.","url":"https://eslint.style/guide/migration","plugin":{"name":"@stylistic/eslint-plugin","url":"https://eslint.style"},"rule":{"name":"spaced-comment","url":"https://eslint.style/rules/spaced-comment"}}]}}]},{"filePath":"C:\\ZimboMate\\src\\data\\advancedMoves.ts","messages":[{"ruleId":"max-lines","severity":1,"message":"File has too many lines (1149). Maximum allowed is 500.","line":501,"column":1,"nodeType":null,"messageId":"exceed","endLine":1150,"endColumn":1}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Advanced moves data for Dungeon World * Level 2 - 5 advanced moves and level 6 - 10 master moves\r\n */\r\n\r\nimport { CharacterClass } from '../models/Character';\r\n\r\nexport interface AdvancedMove {\r\n  id: string;\r\n  name: string;\r\n  description: string;\r\n  level: number;\r\n  class: CharacterClass;\r\n  category: 'advanced' | 'master';\r\n  prerequisites?: string[];\r\n  source?: string;\r\n  page?: number;\r\n}\r\n\r\nexport const ADVANCED_MOVES: AdvancedMove[] = [\r\n  // Fighter Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'fighter-advanced - 1',\r\n    name: 'Heavy Warrior',\r\n    description: 'When you use a weapon with the forceful tag, you may choose to knock your target back 1d3 + 1 spaces and close the distance between you.',\r\n    level: 2,\r\n    class: 'Fighter',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-advanced-2',\r\n    name: 'Armor Mastery',\r\n    description: 'You ignore the clumsy tag on armor you wear.',\r\n    level: 2,\r\n    class: 'Fighter',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-advanced-3',\r\n    name: 'Improved Weapon',\r\n    description: 'Choose one weapon. You deal + 1d4 damage with that weapon.',\r\n    level: 3,\r\n    class: 'Fighter',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-advanced-4',\r\n    name: 'Defensive Fighter',\r\n    description: 'When you use Defy Danger, you may choose to use CON instead of unknown other stat.',\r\n    level: 3,\r\n    class: 'Fighter',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-advanced-5',\r\n    name: 'Intercepting Strike',\r\n    description: 'When an enemy moves to engage you or an ally, you may immediately make a Hack and Slash attack against them.',\r\n    level: 4,\r\n    class: 'Fighter',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-advanced-6',\r\n    name: 'Combat Commander',\r\n    description: 'When you Hack and Slash, you may choose one ally. That ally takes + 1 forward to their next attack.',\r\n    level: 5,\r\n    class: 'Fighter',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n\r\n  // Fighter Master Moves (Level 6-10)\r\n  {\r\n    id: 'fighter-master - 1',\r\n    name: 'Weapon Master',\r\n    description: 'Choose one weapon. You deal + 1d6 damage with that weapon.',\r\n    level: 6,\r\n    class: 'Fighter',\r\n    category: 'master',\r\n    prerequisites: ['Improved Weapon'],\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-master-2',\r\n    name: 'Unstoppable',\r\n    description: 'When you are reduced to 0 HP, you may immediately make a Hack and Slash attack.',\r\n    level: 7,\r\n    class: 'Fighter',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-master-3',\r\n    name: 'Perfect Warrior',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose one. On a 7-9, deal your damage.',\r\n    level: 8,\r\n    class: 'Fighter',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-master-4',\r\n    name: 'Legendary Warrior',\r\n    description: 'When you die, you may choose one ally. That ally takes + 1 forward to all rolls until the end of the session.',\r\n    level: 9,\r\n    class: 'Fighter',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n  {\r\n    id: 'fighter-master-5',\r\n    name: 'Ultimate Warrior',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose two. On a 7-9, deal your damage and choose one.',\r\n    level: 10,\r\n    class: 'Fighter',\r\n    category: 'master',\r\n    prerequisites: ['Perfect Warrior'],\r\n    source: 'Core Rules',\r\n    page: 25,\r\n  },\r\n\r\n  // Wizard Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'wizard-advanced - 1',\r\n    name: 'Empowered Magic',\r\n    description: 'When you cast a spell, you may choose to take-1 ongoing to cast it as if you were one level higher.',\r\n    level: 2,\r\n    class: 'Wizard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-advanced-2',\r\n    name: 'Familiar',\r\n    description: 'You gain a magical familiar. Choose a type: owl, cat, or toad. Your familiar can communicate with you telepathically and has 3 HP.',\r\n    level: 2,\r\n    class: 'Wizard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-advanced-3',\r\n    name: 'Spell Defense',\r\n    description: 'When you are hit by an attack, you may cast a spell you have prepared as a reaction. If you do, the attack deals-1d6 damage.',\r\n    level: 3,\r\n    class: 'Wizard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-advanced-4',\r\n    name: 'Counterspell',\r\n    description: 'When an enemy casts a spell, you may roll + INT. On a 10+, the spell has no effect. On a 7-9, the spell has no effect but you take-1 ongoing.',\r\n    level: 4,\r\n    class: 'Wizard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-advanced-5',\r\n    name: 'Ritual',\r\n    description: 'When you make camp, you may perform a ritual to create a magical effect. Describe the ritual and roll + INT. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 5,\r\n    class: 'Wizard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n\r\n  // Wizard Master Moves (Level 6-10)\r\n  {\r\n    id: 'wizard-master - 1',\r\n    name: 'Spell Mastery',\r\n    description: 'Choose one spell. You may cast that spell without preparing it.',\r\n    level: 6,\r\n    class: 'Wizard',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-master-2',\r\n    name: 'Arcane Ward',\r\n    description: 'You have + 1 armor. When you are hit by an attack, you may choose to lose this armor to negate the attack.',\r\n    level: 7,\r\n    class: 'Wizard',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-master-3',\r\n    name: 'Spellbinder',\r\n    description: 'When you cast a spell, you may choose to bind it to an object. Anyone holding that object may cast the spell once.',\r\n    level: 8,\r\n    class: 'Wizard',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-master-4',\r\n    name: 'Archmage',\r\n    description: 'When you cast a spell, you may choose to cast it as if you were two levels higher.',\r\n    level: 9,\r\n    class: 'Wizard',\r\n    category: 'master',\r\n    prerequisites: ['Empowered Magic'],\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n  {\r\n    id: 'wizard-master-5',\r\n    name: 'Ultimate Magic',\r\n    description: 'When you cast a spell, you may choose to cast it as if you were three levels higher.',\r\n    level: 10,\r\n    class: 'Wizard',\r\n    category: 'master',\r\n    prerequisites: ['Archmage'],\r\n    source: 'Core Rules',\r\n    page: 35,\r\n  },\r\n\r\n  // Cleric Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'cleric-advanced - 1',\r\n    name: 'Divine Guidance',\r\n    description: 'When you pray for guidance, roll + WIS. On a 10+, the GM will tell you what to do. On a 7-9, the GM will give you a choice between two courses of action.',\r\n    level: 2,\r\n    class: 'Cleric',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-advanced-2',\r\n    name: 'Divine Protection',\r\n    description: 'When you use Defy Danger, you may choose to use WIS instead of unknown other stat.',\r\n    level: 2,\r\n    class: 'Cleric',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-advanced-3',\r\n    name: 'Divine Favor',\r\n    description: 'When you use Lay on Hands, you may choose to heal 2d8 HP instead of 1d8.',\r\n    level: 3,\r\n    class: 'Cleric',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-advanced-4',\r\n    name: 'Divine Authority',\r\n    description: 'When you speak with divine authority, roll + CHA. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 4,\r\n    class: 'Cleric',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-advanced-5',\r\n    name: 'Divine Intervention',\r\n    description: 'When you are in a desperate situation, you may call upon your deity for aid. Roll + WIS. On a 10+, your deity intervenes. On a 7-9, your deity intervenes but you owe them a debt.',\r\n    level: 5,\r\n    class: 'Cleric',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n\r\n  // Cleric Master Moves (Level 6-10)\r\n  {\r\n    id: 'cleric-master - 1',\r\n    name: 'Divine Mastery',\r\n    description: 'When you cast a spell, you may choose to cast it as if you were one level higher.',\r\n    level: 6,\r\n    class: 'Cleric',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-master-2',\r\n    name: 'Divine Shield',\r\n    description: 'You have + 1 armor. When you are hit by an attack, you may choose to lose this armor to negate the attack.',\r\n    level: 7,\r\n    class: 'Cleric',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-master-3',\r\n    name: 'Divine Command',\r\n    description: 'When you speak with divine authority, you may choose to command the target to do something. Roll + CHA. On a 10+, they must do it. On a 7-9, they must do it but you owe them a debt.',\r\n    level: 8,\r\n    class: 'Cleric',\r\n    category: 'master',\r\n    prerequisites: ['Divine Authority'],\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-master-4',\r\n    name: 'Divine Avatar',\r\n    description: 'When you are in a desperate situation, you may become an avatar of your deity. Roll + WIS. On a 10+, you gain the power of your deity for a short time. On a 7-9, you gain the power but you owe your deity a great debt.',\r\n    level: 9,\r\n    class: 'Cleric',\r\n    category: 'master',\r\n    prerequisites: ['Divine Intervention'],\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n  {\r\n    id: 'cleric-master-5',\r\n    name: 'Ultimate Divine',\r\n    description: 'When you cast a spell, you may choose to cast it as if you were two levels higher.',\r\n    level: 10,\r\n    class: 'Cleric',\r\n    category: 'master',\r\n    prerequisites: ['Divine Mastery'],\r\n    source: 'Core Rules',\r\n    page: 30,\r\n  },\r\n\r\n  // Thief Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'thief-advanced - 1',\r\n    name: 'Backstab',\r\n    description: 'When you attack a surprised or defenseless enemy, you deal + 1d6 damage.',\r\n    level: 2,\r\n    class: 'Thief',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-advanced-2',\r\n    name: 'Poisoner',\r\n    description: 'You can create poisons. When you create a poison, roll + DEX. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 2,\r\n    class: 'Thief',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-advanced-3',\r\n    name: 'Trap Expert',\r\n    description: 'When you encounter a trap, you may roll + DEX. On a 10+, you can disable it without triggering it. On a 7-9, you can disable it but it triggers.',\r\n    level: 3,\r\n    class: 'Thief',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-advanced-4',\r\n    name: 'Shadow Walker',\r\n    description: 'When you are in shadows or darkness, you are invisible to enemies who cannot see in the dark.',\r\n    level: 4,\r\n    class: 'Thief',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-advanced-5',\r\n    name: 'Master Thief',\r\n    description: 'When you pick a lock or disarm a trap, you may roll + DEX. On a 10+, you do it perfectly. On a 7-9, you do it but make noise.',\r\n    level: 5,\r\n    class: 'Thief',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n\r\n  // Thief Master Moves (Level 6-10)\r\n  {\r\n    id: 'thief-master - 1',\r\n    name: 'Assassin',\r\n    description: 'When you attack a surprised enemy, you deal + 2d6 damage.',\r\n    level: 6,\r\n    class: 'Thief',\r\n    category: 'master',\r\n    prerequisites: ['Backstab'],\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-master-2',\r\n    name: 'Shadow Master',\r\n    description: 'You can become invisible at will. When you are invisible, you have + 1 to all rolls.',\r\n    level: 7,\r\n    class: 'Thief',\r\n    category: 'master',\r\n    prerequisites: ['Shadow Walker'],\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-master-3',\r\n    name: 'Ultimate Thief',\r\n    description: 'When you pick a lock or disarm a trap, you always succeed. When you steal something, you are never caught.',\r\n    level: 8,\r\n    class: 'Thief',\r\n    category: 'master',\r\n    prerequisites: ['Master Thief'],\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-master-4',\r\n    name: 'Legendary Thief',\r\n    description: 'When you die, you may choose one ally. That ally gains all your thieving abilities until the end of the session.',\r\n    level: 9,\r\n    class: 'Thief',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n  {\r\n    id: 'thief-master-5',\r\n    name: 'Shadow Lord',\r\n    description: 'You can control shadows. When you are in shadows, you can see through them and move through them as if they were not there.',\r\n    level: 10,\r\n    class: 'Thief',\r\n    category: 'master',\r\n    prerequisites: ['Shadow Master'],\r\n    source: 'Core Rules',\r\n    page: 40,\r\n  },\r\n\r\n  // Ranger Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'ranger-advanced - 1',\r\n    name: 'Hunter\\'s Mark',\r\n    description: 'When you mark a target, you deal + 1d4 damage to that target until it dies or you mark a new target.',\r\n    level: 2,\r\n    class: 'Ranger',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-advanced-2',\r\n    name: 'Wild Empathy',\r\n    description: 'When you encounter an animal, you may roll + WIS. On a 10+, the animal is friendly to you. On a 7-9, the animal is neutral to you.',\r\n    level: 2,\r\n    class: 'Ranger',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-advanced-3',\r\n    name: 'Camouflage',\r\n    description: 'When you are in natural surroundings, you are invisible to enemies who are not actively searching for you.',\r\n    level: 3,\r\n    class: 'Ranger',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-advanced-4',\r\n    name: 'Survivalist',\r\n    description: 'When you make camp, you may roll + WIS. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 4,\r\n    class: 'Ranger',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-advanced-5',\r\n    name: 'Master Tracker',\r\n    description: 'When you track something, you may roll + WIS. On a 10+, you find it quickly and easily. On a 7-9, you find it but it takes time.',\r\n    level: 5,\r\n    class: 'Ranger',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n\r\n  // Ranger Master Moves (Level 6-10)\r\n  {\r\n    id: 'ranger-master - 1',\r\n    name: 'Beast Master',\r\n    description: 'You gain a loyal animal companion. Choose a type: wolf, hawk, or bear. Your companion has 6 HP and can fight alongside you.',\r\n    level: 6,\r\n    class: 'Ranger',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-master-2',\r\n    name: 'Nature\\'s Ally',\r\n    description: 'When you are in natural surroundings, you may call upon nature for aid. Roll + WIS. On a 10+, nature aids you. On a 7-9, nature aids you but you owe it a debt.',\r\n    level: 7,\r\n    class: 'Ranger',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-master-3',\r\n    name: 'Ultimate Hunter',\r\n    description: 'When you mark a target, you deal + 2d4 damage to that target until it dies or you mark a new target.',\r\n    level: 8,\r\n    class: 'Ranger',\r\n    category: 'master',\r\n    prerequisites: ['Hunter\\'s Mark'],\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-master-4',\r\n    name: 'Legendary Ranger',\r\n    description: 'When you die, you may choose one ally. That ally gains all your ranger abilities until the end of the session.',\r\n    level: 9,\r\n    class: 'Ranger',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n  {\r\n    id: 'ranger-master-5',\r\n    name: 'Nature\\'s Master',\r\n    description: 'You can control nature. When you are in natural surroundings, you can command plants and animals to do your bidding.',\r\n    level: 10,\r\n    class: 'Ranger',\r\n    category: 'master',\r\n    prerequisites: ['Nature\\'s Ally'],\r\n    source: 'Core Rules',\r\n    page: 45,\r\n  },\r\n\r\n  // Bard Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'bard-advanced - 1',\r\n    name: 'Arcane Art',\r\n    description: 'When you use magic, you may choose to use CHA instead of INT.',\r\n    level: 2,\r\n    class: 'Bard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-advanced-2',\r\n    name: 'Bardic Lore',\r\n    description: 'When you first encounter an important creature, location, or item, you may roll + CHA. On a 10+, you know something useful about it. On a 7-9, you know something useful, but it\\'s not what you expected.',\r\n    level: 2,\r\n    class: 'Bard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-advanced-3',\r\n    name: 'Charming and Open',\r\n    description: 'When you speak frankly with someone, you may roll + CHA. On a 10+, they will be honest with you. On a 7-9, they will be honest with you, but they will expect something in return.',\r\n    level: 3,\r\n    class: 'Bard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-advanced-4',\r\n    name: 'A Port in the Storm',\r\n    description: 'When you make camp, you may roll + CHA. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 4,\r\n    class: 'Bard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-advanced-5',\r\n    name: 'The Lore of the Ages',\r\n    description: 'When you first encounter an important creature, location, or item, you may roll + CHA. On a 10+, you know something useful about it. On a 7-9, you know something useful, but it\\'s not what you expected.',\r\n    level: 5,\r\n    class: 'Bard',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n\r\n  // Bard Master Moves (Level 6-10)\r\n  {\r\n    id: 'bard-master - 1',\r\n    name: 'An Ear for Magic',\r\n    description: 'When you hear a spell cast, you may roll + CHA. On a 10+, you can cast that spell once. On a 7-9, you can cast that spell once, but you take-1 ongoing until you do.',\r\n    level: 6,\r\n    class: 'Bard',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-master-2',\r\n    name: 'A Port in the Storm',\r\n    description: 'When you make camp, you may roll + CHA. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 7,\r\n    class: 'Bard',\r\n    category: 'master',\r\n    prerequisites: ['A Port in the Storm'],\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-master-3',\r\n    name: 'The Lore of the Ages',\r\n    description: 'When you first encounter an important creature, location, or item, you may roll + CHA. On a 10+, you know something useful about it. On a 7-9, you know something useful, but it\\'s not what you expected.',\r\n    level: 8,\r\n    class: 'Bard',\r\n    category: 'master',\r\n    prerequisites: ['The Lore of the Ages'],\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-master-4',\r\n    name: 'Legendary Bard',\r\n    description: 'When you die, you may choose one ally. That ally gains all your bard abilities until the end of the session.',\r\n    level: 9,\r\n    class: 'Bard',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n  {\r\n    id: 'bard-master-5',\r\n    name: 'Ultimate Bard',\r\n    description: 'When you perform, you may choose to inspire all allies within earshot. They take + 1 forward to all rolls until the end of the scene.',\r\n    level: 10,\r\n    class: 'Bard',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 50,\r\n  },\r\n\r\n  // Druid Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'druid-advanced - 1',\r\n    name: 'Balanced',\r\n    description: 'When you use Defy Danger, you may choose to use WIS instead of unknown other stat.',\r\n    level: 2,\r\n    class: 'Druid',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-advanced-2',\r\n    name: 'By Nature Sustained',\r\n    description: 'You don\\'t need to eat or drink. If you choose to, you can subsist on what you forage with no chance of starvation or dehydration.',\r\n    level: 2,\r\n    class: 'Druid',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-advanced-3',\r\n    name: 'Communion',\r\n    description: 'When you commune with nature, you may roll + WIS. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 3,\r\n    class: 'Druid',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-advanced-4',\r\n    name: 'Formcrafter',\r\n    description: 'When you shapeshift, you may choose to take on a form that is a combination of two animals.',\r\n    level: 4,\r\n    class: 'Druid',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-advanced-5',\r\n    name: 'Elemental Mastery',\r\n    description: 'When you use magic, you may choose to use WIS instead of INT.',\r\n    level: 5,\r\n    class: 'Druid',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n\r\n  // Druid Master Moves (Level 6-10)\r\n  {\r\n    id: 'druid-master - 1',\r\n    name: 'Elemental Mastery',\r\n    description: 'When you use magic, you may choose to use WIS instead of INT.',\r\n    level: 6,\r\n    class: 'Druid',\r\n    category: 'master',\r\n    prerequisites: ['Elemental Mastery'],\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-master-2',\r\n    name: 'Formcrafter',\r\n    description: 'When you shapeshift, you may choose to take on a form that is a combination of two animals.',\r\n    level: 7,\r\n    class: 'Druid',\r\n    category: 'master',\r\n    prerequisites: ['Formcrafter'],\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-master-3',\r\n    name: 'Communion',\r\n    description: 'When you commune with nature, you may roll + WIS. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 8,\r\n    class: 'Druid',\r\n    category: 'master',\r\n    prerequisites: ['Communion'],\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-master-4',\r\n    name: 'Legendary Druid',\r\n    description: 'When you die, you may choose one ally. That ally gains all your druid abilities until the end of the session.',\r\n    level: 9,\r\n    class: 'Druid',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n  {\r\n    id: 'druid-master-5',\r\n    name: 'Ultimate Druid',\r\n    description: 'When you shapeshift, you may choose to take on a form that is a combination of three animals.',\r\n    level: 10,\r\n    class: 'Druid',\r\n    category: 'master',\r\n    prerequisites: ['Formcrafter'],\r\n    source: 'Core Rules',\r\n    page: 55,\r\n  },\r\n\r\n  // Paladin Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'paladin-advanced - 1',\r\n    name: 'I Am the Law',\r\n    description: 'When you give an order, you may roll + CHA. On a 10+, they must do it. On a 7-9, they must do it but you owe them a debt.',\r\n    level: 2,\r\n    class: 'Paladin',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-advanced-2',\r\n    name: 'Lay on Hands',\r\n    description: 'When you touch someone, you may roll + WIS. On a 10+, heal 1d8 HP. On a 7-9, heal 1d8 HP but you take 1d4 damage.',\r\n    level: 2,\r\n    class: 'Paladin',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-advanced-3',\r\n    name: 'Armored',\r\n    description: 'You ignore the clumsy tag on armor you wear.',\r\n    level: 3,\r\n    class: 'Paladin',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-advanced-4',\r\n    name: 'I Am the Law',\r\n    description: 'When you give an order, you may roll + CHA. On a 10+, they must do it. On a 7-9, they must do it but you owe them a debt.',\r\n    level: 4,\r\n    class: 'Paladin',\r\n    category: 'advanced',\r\n    prerequisites: ['I Am the Law'],\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-advanced-5',\r\n    name: 'Lay on Hands',\r\n    description: 'When you touch someone, you may roll + WIS. On a 10+, heal 2d8 HP. On a 7-9, heal 2d8 HP but you take 1d6 damage.',\r\n    level: 5,\r\n    class: 'Paladin',\r\n    category: 'advanced',\r\n    prerequisites: ['Lay on Hands'],\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n\r\n  // Paladin Master Moves (Level 6-10)\r\n  {\r\n    id: 'paladin-master - 1',\r\n    name: 'Divine Favor',\r\n    description: 'When you use Lay on Hands, you may choose to heal 3d8 HP instead of 2d8.',\r\n    level: 6,\r\n    class: 'Paladin',\r\n    category: 'master',\r\n    prerequisites: ['Lay on Hands'],\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-master-2',\r\n    name: 'Divine Authority',\r\n    description: 'When you speak with divine authority, roll + CHA. On a 10+, choose 3. On a 7-9, choose 1.',\r\n    level: 7,\r\n    class: 'Paladin',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-master-3',\r\n    name: 'Divine Command',\r\n    description: 'When you speak with divine authority, you may choose to command the target to do something. Roll + CHA. On a 10+, they must do it. On a 7-9, they must do it but you owe them a debt.',\r\n    level: 8,\r\n    class: 'Paladin',\r\n    category: 'master',\r\n    prerequisites: ['Divine Authority'],\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-master-4',\r\n    name: 'Legendary Paladin',\r\n    description: 'When you die, you may choose one ally. That ally gains all your paladin abilities until the end of the session.',\r\n    level: 9,\r\n    class: 'Paladin',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n  {\r\n    id: 'paladin-master-5',\r\n    name: 'Ultimate Paladin',\r\n    description: 'When you use Lay on Hands, you may choose to heal 4d8 HP instead of 3d8.',\r\n    level: 10,\r\n    class: 'Paladin',\r\n    category: 'master',\r\n    prerequisites: ['Divine Favor'],\r\n    source: 'Core Rules',\r\n    page: 60,\r\n  },\r\n\r\n  // Barbarian Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'barbarian-advanced - 1',\r\n    name: 'What Are You Waiting For?',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose one. On a 7-9, deal your damage.',\r\n    level: 2,\r\n    class: 'Barbarian',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-advanced-2',\r\n    name: 'My Love For You Is Like a Truck',\r\n    description: 'When you use Defy Danger, you may choose to use STR instead of unknown other stat.',\r\n    level: 2,\r\n    class: 'Barbarian',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-advanced-3',\r\n    name: 'What Are You Waiting For?',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose two. On a 7-9, deal your damage and choose one.',\r\n    level: 3,\r\n    class: 'Barbarian',\r\n    category: 'advanced',\r\n    prerequisites: ['What Are You Waiting For?'],\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-advanced-4',\r\n    name: 'My Love For You Is Like a Truck',\r\n    description: 'When you use Defy Danger, you may choose to use STR instead of unknown other stat.',\r\n    level: 4,\r\n    class: 'Barbarian',\r\n    category: 'advanced',\r\n    prerequisites: ['My Love For You Is Like a Truck'],\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-advanced-5',\r\n    name: 'What Are You Waiting For?',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose three. On a 7-9, deal your damage and choose two.',\r\n    level: 5,\r\n    class: 'Barbarian',\r\n    category: 'advanced',\r\n    prerequisites: ['What Are You Waiting For?'],\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n\r\n  // Barbarian Master Moves (Level 6-10)\r\n  {\r\n    id: 'barbarian-master - 1',\r\n    name: 'What Are You Waiting For?',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose four. On a 7-9, deal your damage and choose three.',\r\n    level: 6,\r\n    class: 'Barbarian',\r\n    category: 'master',\r\n    prerequisites: ['What Are You Waiting For?'],\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-master-2',\r\n    name: 'My Love For You Is Like a Truck',\r\n    description: 'When you use Defy Danger, you may choose to use STR instead of unknown other stat.',\r\n    level: 7,\r\n    class: 'Barbarian',\r\n    category: 'master',\r\n    prerequisites: ['My Love For You Is Like a Truck'],\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-master-3',\r\n    name: 'What Are You Waiting For?',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose five. On a 7-9, deal your damage and choose four.',\r\n    level: 8,\r\n    class: 'Barbarian',\r\n    category: 'master',\r\n    prerequisites: ['What Are You Waiting For?'],\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-master-4',\r\n    name: 'Legendary Barbarian',\r\n    description: 'When you die, you may choose one ally. That ally gains all your barbarian abilities until the end of the session.',\r\n    level: 9,\r\n    class: 'Barbarian',\r\n    category: 'master',\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n  {\r\n    id: 'barbarian-master-5',\r\n    name: 'Ultimate Barbarian',\r\n    description: 'When you Hack and Slash, you may choose to deal your damage or roll + STR. On a 10+, deal your damage and choose six. On a 7-9, deal your damage and choose five.',\r\n    level: 10,\r\n    class: 'Barbarian',\r\n    category: 'master',\r\n    prerequisites: ['What Are You Waiting For?'],\r\n    source: 'Core Rules',\r\n    page: 65,\r\n  },\r\n\r\n  // Immolator Advanced Moves (Level 2-5)\r\n  {\r\n    id: 'immolator-advanced - 1',\r\n    name: 'Fireproof',\r\n    description: 'You are immune to fire damage.',\r\n    level: 2,\r\n    class: 'Immolator',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 70,\r\n  },\r\n  {\r\n    id: 'immolator-advanced-2',\r\n    name: 'Burning Brand',\r\n    description: 'When you use magic, you may choose to use INT instead of unknown other stat.',\r\n    level: 2,\r\n    class: 'Immolator',\r\n    category: 'advanced',\r\n    source: 'Core Rules',\r\n    page: 70,\r\n  },\r\n  {\r\n    id: 'immolator-advanced-3',\r\n    name: 'Fireproof',\r\n    description: 'You are immune to fire damage and can see through smoke.',\r\n    level: 3,\r\n    class: 'Immolator',\r\n    category: 'advanced',\r\n    prerequisites: ['Fireproof'],\r\n    source: 'Core Rules',\r\n    page: 70,\r\n  },\r\n  {\r\n    id: 'immolator-advanced-4',\r\n    name: 'Burning Brand',\r\n    description: 'When you use magic, you may choose to use INT instead of unknown other stat.',\r\n    level: 4,\r\n    class: 'Immolator',\r\n    category: 'advanced',\r\n    prerequisites: ['Burning Brand'],\r\n    source: 'Core Rules',\r\n    page: 70,\r\n  },\r\n  {\r\n    id: 'immolator-advanced-5',\r\n    name: 'Fireproof',\r\n    description: 'You are immune to fire damage, can see through smoke, and can breathe in smoke-filled areas.',\r\n    level: 5,\r\n    class: 'Immolator',\r\n    category: 'advanced',\r\n    prerequisites: ['Fireproof'],\r\n    source: 'Core Rules',\r\n    page: 70,\r\n  },\r\n\r\n  // Immolator Master Moves (Level 6-10)\r\n  {\r\n    id: 'immolator-master - 1',\r\n    name: 'Fireproof',\r\n    description: 'You are immune to fire damage, can see through smoke, can breathe in smoke-filled areas, and can control fire.',\r\n    level: 6,\r\n    class: 'Immolator',\r\n    category: 'master',\r\n    prerequisites: ['Fireproof'],\r\n    source: 'Core Rules',\r\n 
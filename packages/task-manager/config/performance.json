{
  "thresholds": {
    "panelSwitchTime": 100,
    "renderTime": 50,
    "memoryUsage": 100,
    "loadTime": 2000
  },
  "responsive": {
    "breakpoints": {
      "desktop": 1200,
      "tablet": 768,
      "mobile": 480
    },
    "sidebarWidths": {
      "desktop": 250,
      "tablet": 200,
      "mobile": "100%"
    },
    "transitions": {
      "desktop": 250,
      "tablet": 200,
      "mobile": 150
    }
  },
  "optimizations": {
    "debounce": {
      "stateSave": 300,
      "autoSave": 2000,
      "search": 500
    },
    "preload": {
      "adjacentPanels": true,
      "maxPreload": 2
    },
    "lazyLoading": {
      "enabled": true,
      "threshold": 0.1
    }
  },
  "monitoring": {
    "enabled": true,
    "maxMetrics": 100,
    "logWarnings": true,
    "developmentMode": true
  },
  "accessibility": {
    "reducedMotion": true,
    "highContrast": true,
    "screenReader": true
  },
  "build": {
    "chunkSizeWarningLimit": 1000,
    "sourcemap": false,
    "minify": true,
    "treeShaking": true
  }
}

{
  "name": "zimbomate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "arwes-monorepo/packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",

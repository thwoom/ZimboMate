    "framer-motion": "^11.0.0",
    "howler": "^2.2.4",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.543.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^6.30.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "three": "^0.160.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6",
    "zustand": "^4.4.0"

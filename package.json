    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/rapier": "^2.1.0",
    "@tanstack/react-query": "^5.89.0",
    "@tanstack/react-query-devtools": "^5.87.3",
    "@tanstack/react-virtual": "^3.13.12",

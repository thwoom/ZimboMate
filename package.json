{
  "name": "@zimbo-mate/zimbomate-v2",
  "type": "module",
  "version": "2.0.0",
  "description": "ZimboMate V2 - A magical Dungeon World companion app",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "test:gaming": "vitest run src/components/__tests__/gaming/",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "clean": "rimraf dist",
    "lighthouse": "lighthouse-ci",
    "screenshot": "playwright test tests/e2e/visual --project=\"Desktop Chrome\" --update-snapshots",
    "screenshot:analyze": "playwright test tests/e2e/visual --project=\"Desktop Chrome\"",
    "test:all": "npm run test:run && npm run test:a11y && npm run test:perf && npm run test:gaming",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "test:visual": "playwright test tests/e2e/visual --project=\"Desktop Chrome\"",
    "test:smoke": "npm run lint && npm run build && vitest run --single-thread --reporter=basic && playwright test --project=\"Desktop Chrome\" --workers=1",
    "test:watchdog": "node scripts/run-tests-with-watchdog.mjs"
  },
  "dependencies": {
